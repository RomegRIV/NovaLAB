rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return signedIn() ? request.auth.token.role : ''; }
    function isSuper() { return role() == 'Superusuario'; }
    function isAdmin() { return role() in ['Superusuario', 'Administrador']; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isSuper());
      allow create, update, delete: if false; // Solo Cloud Functions con Admin SDK administra perfiles.
    }
    match /materials/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /loans/{id} {
      allow read: if signedIn();
      allow create, update, delete: if false; // Operaciones transaccionales mediante Cloud Functions.
    }
    match /movements/{id} {
      allow read: if signedIn();
      allow create: if isAdmin();
      allow update, delete: if false; // El historial es inmutable después de crearse.
    }
    match /{document=**} { allow read, write: if false; }
  }
}
